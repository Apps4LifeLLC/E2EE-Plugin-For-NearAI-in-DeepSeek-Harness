{
  "name": "dsh-llm-nearai-tee",
  "version": "0.2.0",
  "private": true,
  "description": "NEAR AI E2EE provider for DeepSeek Harness: verified TEE attestation, field-level encryption, provider_tee response receipts, and an E2EE verification badge.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/adapter.test.mjs"
  },
  "dependencies": {
    "@nearai/inference-sdk": "0.2.1"
  }
}
